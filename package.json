{
  "name": "eduinsight-ai",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "data:generate": "node scripts/generate-synthetic-university.mjs",
    "data:ingest": "node scripts/build-command-center.mjs",
    "data:refresh": "npm run data:generate && npm run data:ingest",
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "test": "npm run build && node --test tests/rendered-html.test.mjs",
    "eval:ask": "node tests/ask-engine-evaluation.mjs",
    "eval:blind": "node tests/ask-engine-blind-evaluation.mjs",
    "eval:blind2": "node tests/ask-engine-blind-2-evaluation.mjs",
    "test:adversarial": "node --test tests/ask-engine-adversarial.test.mjs",
    "test:systemic": "node --test tests/ask-engine-systemic.test.mjs",
    "test:ask-release": "npm run eval:ask && npm run eval:blind && npm run eval:blind2 && npm run test:adversarial && npm run test:systemic",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
