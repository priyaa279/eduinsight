{
  "name": "eduinsight-ai",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "data:generate": "node scripts/generate-synthetic-university.mjs && node scripts/generate-ipeds-marts.mjs",
    "data:ingest": "node scripts/build-command-center.mjs && node scripts/build-scenario-baselines.mjs",
    "data:refresh": "npm run data:generate && npm run data:ingest",
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "test": "npm run build && node --test tests/rendered-html.test.mjs",
    "eval:ask": "node tests/ask-engine-evaluation.mjs",
    "eval:blind": "node tests/ask-engine-blind-evaluation.mjs",
    "eval:blind2": "node tests/ask-engine-blind-2-evaluation.mjs",
    "eval:blind3": "node tests/ask-engine-blind-3-evaluation.mjs",
    "eval:blind3:regression": "node tests/ask-engine-blind-3-regression.mjs",
    "eval:blind4:regression": "node tests/ask-engine-blind-4-regression.mjs",
    "eval:blind5:regression": "node tests/ask-engine-blind-5-regression.mjs",
    "eval:blind6:regression": "node tests/ask-engine-blind-6-regression.mjs",
    "eval:blind7:regression": "node tests/ask-engine-blind-7-regression.mjs",
    "eval:blind9:regression": "node tests/ask-engine-blind-9-regression.mjs",
    "test:semantic-plan": "node --test tests/semantic-plan.test.mjs",
    "test:semantic-parser": "node --test tests/semantic-parser-boundary.test.mjs",
    "test:no-api-contract": "node --test tests/no-api-local-contract.test.mjs",
    "test:planner-ui": "node --test tests/planner-presentation.test.mjs",
    "test:adversarial": "node --test tests/ask-engine-adversarial.test.mjs",
    "test:systemic": "node --test tests/ask-engine-systemic.test.mjs",
    "test:intent-routing": "node --test tests/intent-routing.test.mjs",
    "test:ipeds-com": "node --test tests/ipeds-com.test.mjs",
    "test:ipeds-ef": "node --test tests/ipeds-ef.test.mjs",
    "test:ipeds-suite": "node --test tests/ipeds-suite.test.mjs",
    "test:governance-memory": "node --test tests/institutional-memory.test.mjs tests/institutional-memory-search.test.mjs",
    "test:scenario": "node --test tests/scenario-model.test.mjs",
    "test:ask-release": "npm run eval:ask && npm run eval:blind && npm run eval:blind2 && npm run eval:blind3:regression && npm run eval:blind4:regression && npm run eval:blind5:regression && npm run eval:blind6:regression && npm run eval:blind7:regression && npm run eval:blind9:regression && npm run test:semantic-plan && npm run test:semantic-parser && npm run test:no-api-contract && npm run test:planner-ui && npm run test:adversarial && npm run test:systemic && npm run test:scenario && node scripts/report-ask-release.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
