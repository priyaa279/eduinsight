  "annualChanges": {
    "collectionYear": "2025-26",
    "diffId": "ipeds-annual-diff.2024_25-to-2025_26",
    "sourceUrl": "https://nces.ed.gov/ipeds/report-your-data/archived-changes",
    "requiresAcknowledgment": true,
    "changes": [
      {
        "component": "AL",
        "type": "removed",
        "summary": "Academic Libraries was retired as an IPEDS survey component beginning in 2025-26."
      },
      {
        "component": "GR",
        "type": "terminology-and-field-change",
        "summary": "The federal materials use sex, male, and female terminology; Another Gender is no longer collected."
      },
      {
        "component": "IC/ADM",
        "type": "field-moved",
        "summary": "The open-admissions screening question moved from IC to ADM."
      },
      {
        "component": "CST",
        "type": "component-change",
        "summary": "Cost remains a separately versioned component spanning the Fall and Winter collection periods."
      },
      {
        "component": "SFA",
        "type": "section-redesign",
        "summary": "Section 1 collects consistent aid types across undergraduate categories, and IASG awards are included with Federal Pell Grant counts and amounts."
      },
      {
        "component": "ADM",
        "type": "expanded-collection",
        "summary": "Admissions adds transfer-in reporting, expanded race/ethnicity and attendance-status detail, and waitlist, Early Decision, and Early Action elements when applicable."
      },
      {
        "component": "C/E12/OM/ADM/EF",
        "type": "terminology-and-field-change",
        "summary": "The applicable 2025-26 forms use sex, male, and female terminology; non-binary/Another Gender fields are no longer collected."
      }
    ]
  },
